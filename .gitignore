# ── Environment / secrets ───────────────
.env
*.env.local

# ── Docker artifacts ────────────────────
docker-compose.override.yml
# (Dockerfile a docker-compose.yml se commitují — jsou součástí projektu)

# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Editors / OS ────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── AutoGenBook run artifacts ──────────
# (složka output/ je u upstreamu částečně tracknutá; lokální běhy ukládáme
#  do output/ a jen vybrané výsledky commitneme vědomě)
*.log

# Web UI project data (generovaná uživatelská data, nepatří do gitu)
projects/

# Server-level global prompt overrides (user data)
global_prompts.json
global_config.json
