# AutoGenBook environment (copy this file to .env and fill in your keys)
# ── OpenRouter (required for the default provider) ────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the LLM provider with any OpenAI-compatible endpoint
# (e.g. local LM Studio on the host). Use host.docker.internal on Docker Windows.
#AUTOGENBOOK_LLM_BASE_URL=http://host.docker.internal:1234/v1
#AUTOGENBOOK_LLM_API_KEY=local-key

# Force a specific model for all runs (optional).
#AUTOGENBOOK_FORCE_MINI_MODEL=1

# Fail fast on schema validation errors (optional).
#AUTOGENBOOK_FAIL_FAST_SCHEMA=1
