# AutoGenBook environment (copy this file to .env and fill in your keys)
# ── OpenRouter (required only if you use the default provider) ─────
#OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI-compatible provider (recommended, e.g. e-INFRA) ───────────
# Base URL of an OpenAI-compatible endpoint (usually ends with /v1).
#AUTOGENBOOK_LLM_BASE_URL=https://llm.ai.e-infra.cz/v1
#AUTOGENBOOK_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#AUTOGENBOOK_LLM_MODEL=qwen3.5

# The base URL/key fall back to OPENROUTER_API_KEY / OpenRouter when unset.
# AUTOGENBOOK_LLM_MODEL overrides the default model for all runs
# (default when unset: openai/gpt-5-mini on OpenRouter).

# Force the built-in mini model for all runs (highest priority, optional).
#AUTOGENBOOK_FORCE_MINI_MODEL=1

# Fail fast on schema validation errors (optional).
#AUTOGENBOOK_FAIL_FAST_SCHEMA=1

# ── Web UI authentication (optional) ────────────────────────────────
# Pokud nastavíš heslo, UI se odemkne jen po přihlášení (kdo zná heslo, projde).
# Když necháš prázdné, UI je bez hesla (vhodné jen pro lokální běh).
#AUTOGENBOOK_UI_PASSWORD=tajne-heslo
